    <string name="perm_usage_title">App usage</string>
    <string name="perm_usage_body">FamilyGuard needs to know which apps you open and for how long, so your parents can set screen-time limits. The app list is shared with them.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_body">A small notification stays on your screen with the words "Parental controls active" — because that is what is running. Blocking notices also arrive there.</string>
    <string name="perm_overlay_title">Display over other apps</string>
    <string name="perm_overlay_body">When one of your apps is blocked, FamilyGuard shows a full-screen notice explaining why. This permission lets that notice appear over the blocked app.</string>
    <string name="perm_background_location_title">Location</string>
    <string name="perm_background_location_body">Your parents can find this device on the map even when FamilyGuard is closed. That is why we ask for "Allow all the time" instead of "Only while using the app" — the second would silently stop the family map whenever you close the app.</string>
    <string name="perm_background_location_allow_fine">Allow location access</string>
    <string name="perm_background_location_allow_bg">Allow all the time</string>
    <string name="perm_device_admin_title">Turn on Device Admin</string>
    <string name="perm_device_admin_body">Activating this shows \"Parental controls active\" in your phone\'s settings and uninstalling FamilyGuard is blocked while it is on. Nothing is hidden from you — and you can still turn the admin off any time in Settings &gt; Apps &gt; Special access &gt; Device admin apps; your parent is notified right away when that happens.</string>
    <string name="perm_device_admin_activate">Turn on Device Admin</string>
