<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Enforcement, location and heartbeat permissions live in
         :service:enforcement / :service:location so each module owns its
         policy surface; they merge into this manifest (PLAN §6.1). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Deliberately undisguised: a real icon, the real name, a launcher
         entry and no hiding from recents (PLAN-SPLIT §6.1/§6.5). -->
    <application
        android:name=".FamilyGuardApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FamilyGuard"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
